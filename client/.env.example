# =============================================================================
# Client — Local Development Environment
# Copy this file to .env and fill in the values.
# EXPO_PUBLIC_* variables are bundled into the app at build time — never put
# secrets here. Use server-side env vars for anything sensitive.
# =============================================================================

# ─── API ──────────────────────────────────────────────────────────────────────
# Local dev:   http://localhost:8000/api/v1
# Production:  https://your-service-name.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
