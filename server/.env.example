# ─── Database ────────────────────────────────────────────────────────────────
# Async PostgreSQL URL (asyncpg driver)
# Local: postgresql+asyncpg://meuguia:meuguia@localhost:5432/meuguia
# Supabase: postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql+asyncpg://meuguia:meuguia@localhost:5432/meuguia

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
CONTACT_EMAIL=fabio9162@gmail.com
