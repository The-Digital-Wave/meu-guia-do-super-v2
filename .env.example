# =============================================================================
# GitHub Actions Secrets
# Add these at: repo → Settings → Secrets and variables → Actions
# =============================================================================

# ─── Docker Hub ──────────────────────────────────────────────────────────────
# hub.docker.com → Account settings → Personal access tokens → Generate new token
# Permissions: Read & Write
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Render ───────────────────────────────────────────────────────────────────
# dashboard.render.com → avatar → Account Settings → API Keys → Create API Key
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Render dashboard URL for the service: dashboard.render.com/web/srv-XXXXXXXXXX
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx

# ─── Vercel ───────────────────────────────────────────────────────────────────
# vercel.com → Settings → Tokens → Create Token (scope: Full Account)
VERCEL_TOKEN=vcp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Run `vercel link` in client/ and read from client/.vercel/project.json
VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Expo ────────────────────────────────────────────────────────────────────
# expo.dev → avatar → Access Tokens → Create Token
EXPO_TOKEN=rnqf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Runtime (passed from CI to Render) ──────────────────────────────────────
# Set after Render service is deployed — use the Render service's public URL
# Format: https://<service-name>.onrender.com/api/v1
EXPO_PUBLIC_API_URL=https://your-service-name.onrender.com/api/v1
