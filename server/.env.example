# =============================================================================
# Server — Local Development Environment
# Copy this file to .env and fill in the values.
# Production values live in Render dashboard → Environment, NOT here.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# Async PostgreSQL URL (asyncpg driver required by SQLAlchemy async)
# Local:    postgresql+asyncpg://meuguia:meuguia@localhost:5432/meuguia
# Supabase: supabase.com → Project Settings → Database → Connection string (URI)
#           Change prefix from postgresql:// → postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://meuguia:meuguia@localhost:5432/meuguia

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (run twice — must be different strings)
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-hex-32-different
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: upstash.com → Redis → your DB → Details → Redis URL (starts with rediss://)
REDIS_URL=redis://localhost:6379
# Upstash REST token (only needed in production with Upstash HTTP client)
# upstash.com → Redis → your DB → Details → REST API → token
REDIS_TOKEN=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list — no trailing slashes
# Production: https://meu-guia-do-super-v2-web.vercel.app,https://meu-guia-do-super-api-v2.onrender.com
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# resend.com → API Keys → Create API Key (Full access)
RESEND_API_KEY=re_your_key_here
CONTACT_EMAIL=fabio9162@gmail.com

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
